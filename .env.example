# --- Application ---
APP_ENV=development
APP_NAME=NIRIKSH API

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://niriksh:niriksh@localhost:5432/niriksh

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:3000

# --- File storage ---
STORAGE_DIR=storage

# --- AI providers (comma-separated keys enable rotation) ---
GROQ_API_KEYS=
OCR_MODEL=qwen/qwen3.8-27b
AGGREGATOR_MODEL=qwen/qwen3.8-27b
AGGREGATOR_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Computer vision ---
YOLO_MODEL_PATH=backend/models/yolov8n-seg.pt
